@model OcpProduction.Web.ViewModels.ReferenceData.WorkShiftListViewModel

@{
    ViewData["Title"] = "Postes";
}

<partial name="_ReferenceMessages" />
<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div><h1 class="h3">Postes</h1><p class="text-muted mb-0">Les codes restent immuables après création.</p></div>
    <a class="btn btn-primary" asp-action="CreateWorkShift">Nouveau poste</a>
</div>
<div class="table-responsive"><table class="table table-hover align-middle">
<caption class="visually-hidden">Liste des postes</caption>
<thead><tr><th scope="col">Code</th><th scope="col">Nom</th><th scope="col">Début</th><th scope="col">Fin</th><th scope="col">Usage</th><th scope="col">État</th><th scope="col" class="text-end">Actions</th></tr></thead>
<tbody>
@foreach (var item in Model.Items)
{
    <tr>
        <th scope="row">@item.Code</th><td>@item.Name</td><td>@item.StartTime</td><td>@item.EndTime</td><td>@(item.TripUsageCount + item.StopUsageCount)</td>
        <td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Actif" : "Inactif")</span></td>
        <td class="text-end">
            @if (item.CanEdit) { <a class="btn btn-sm btn-outline-secondary" asp-action="EditWorkShift" asp-route-id="@item.Id">Modifier</a> }
            <form method="post" class="d-inline" asp-action="SetWorkShiftActive" asp-route-id="@item.Id">
                @Html.AntiForgeryToken()
                <input type="hidden" name="isActive" value="@(!item.IsActive)" />
                <button class="btn btn-sm btn-outline-primary" type="submit">@(item.IsActive ? "Désactiver" : "Activer")</button>
            </form>
        </td>
    </tr>
}
</tbody></table></div>
