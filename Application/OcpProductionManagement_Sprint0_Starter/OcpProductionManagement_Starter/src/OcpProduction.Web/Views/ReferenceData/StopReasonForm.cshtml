@model OcpProduction.Web.ViewModels.ReferenceData.StopReasonFormViewModel

@{ ViewData["Title"] = Model.IsEdit ? "Modifier un motif d'arrêt" : "Créer un motif d'arrêt"; }
<h1 class="h3 mb-4">@ViewData["Title"]</h1>
<form method="post" class="card border-0 shadow-sm"><div class="card-body row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-3"><label asp-for="Input.Code" class="form-label">Code</label><input asp-for="Input.Code" class="form-control" readonly="@Model.IsEdit" /><span asp-validation-for="Input.Code" class="text-danger"></span></div><div class="col-md-5"><label asp-for="Input.Name" class="form-label">Nom</label><input asp-for="Input.Name" class="form-control" /><span asp-validation-for="Input.Name" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Input.Category" class="form-label">Catégorie</label><select asp-for="Input.Category" class="form-select"><option value="">Non renseignée</option>@foreach (var category in Model.Categories) { <option value="@category">@category</option> }</select></div><div class="col-md-6 form-check ms-2"><input asp-for="Input.IsPlanned" class="form-check-input" /><label asp-for="Input.IsPlanned" class="form-check-label">Planifié</label></div><div class="col-md-6 form-check ms-2"><input asp-for="Input.IsActive" class="form-check-input" /><label asp-for="Input.IsActive" class="form-check-label">Actif</label></div></div><div class="card-footer bg-white d-flex gap-2"><button class="btn btn-primary" type="submit">Enregistrer</button><a class="btn btn-outline-secondary" asp-action="StopReasons">Annuler</a></div></form>
