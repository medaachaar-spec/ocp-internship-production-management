@model OcpProduction.Web.ViewModels.ReferenceData.DestinationFormViewModel

@{ ViewData["Title"] = Model.IsEdit ? "Modifier une destination" : "Créer une destination"; }
<h1 class="h3 mb-4">@ViewData["Title"]</h1>
<form method="post" class="card border-0 shadow-sm"><div class="card-body row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-3"><label asp-for="Input.Code" class="form-label">Code</label><input asp-for="Input.Code" class="form-control" readonly="@Model.IsEdit" /><span asp-validation-for="Input.Code" class="text-danger"></span></div><div class="col-md-5"><label asp-for="Input.Name" class="form-label">Nom</label><input asp-for="Input.Name" class="form-control" /><span asp-validation-for="Input.Name" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Input.Type" class="form-label">Type</label><select asp-for="Input.Type" class="form-select"><option value="">Non renseigné</option>@foreach (var type in Model.Types) { <option value="@type">@type</option> }</select></div><div class="col-12 form-check ms-2"><input asp-for="Input.IsActive" class="form-check-input" /><label asp-for="Input.IsActive" class="form-check-label">Actif</label></div></div><div class="card-footer bg-white d-flex gap-2"><button class="btn btn-primary" type="submit">Enregistrer</button><a class="btn btn-outline-secondary" asp-action="Destinations">Annuler</a></div></form>
