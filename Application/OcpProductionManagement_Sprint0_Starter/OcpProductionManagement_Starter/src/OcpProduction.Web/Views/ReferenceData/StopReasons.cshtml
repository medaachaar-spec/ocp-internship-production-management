@model OcpProduction.Web.ViewModels.ReferenceData.StopReasonListViewModel

@{ ViewData["Title"] = "Motifs d'arrêt"; }
<partial name="_ReferenceMessages" />
<div class="d-flex justify-content-between align-items-start gap-3 mb-4"><div><h1 class="h3">Motifs d'arrêt</h1><p class="text-muted mb-0">Catégories conformes à la contrainte SQL Server validée.</p></div><a class="btn btn-primary" asp-action="CreateStopReason">Nouveau motif</a></div>
<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Code</th><th>Nom</th><th>Catégorie</th><th>Planifié</th><th>Usage</th><th>État</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@item.Code</td><td>@item.Name</td><td>@(item.Category ?? "—")</td><td>@(item.IsPlanned ? "Oui" : "Non")</td><td>@item.StopUsageCount</td><td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Actif" : "Inactif")</span></td><td class="text-end">@if (item.CanEdit) { <a class="btn btn-sm btn-outline-secondary" asp-action="EditStopReason" asp-route-id="@item.Id">Modifier</a> } <form method="post" class="d-inline" asp-action="SetStopReasonActive" asp-route-id="@item.Id">@Html.AntiForgeryToken()<input type="hidden" name="isActive" value="@(!item.IsActive)" /><button class="btn btn-sm btn-outline-primary" type="submit">@(item.IsActive ? "Désactiver" : "Activer")</button></form></td></tr> }</tbody></table></div>
