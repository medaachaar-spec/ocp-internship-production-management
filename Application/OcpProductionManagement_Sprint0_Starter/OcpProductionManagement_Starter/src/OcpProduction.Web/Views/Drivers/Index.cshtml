@model OcpProduction.Web.ViewModels.Drivers.DriverIndexViewModel
@using System.Globalization
@using OcpProduction.Application.Drivers.Models
@using OcpProduction.Web.ViewModels.Drivers
@{
    ViewData["Title"] = "Conducteurs";
    var culture = CultureInfo.GetCultureInfo("fr-FR");
}
<div class="page-header"><h1>Conducteurs</h1><p class="text-muted mb-0">Consultez les conducteurs enregistrés et leur activité opérationnelle.</p></div>
<section class="card border-0 shadow-sm mb-4" aria-labelledby="driver-filter-title"><div class="card-body"><h2 id="driver-filter-title" class="h5 mb-3">Filtres</h2><form asp-action="Index" method="get" class="row g-3">
    <div class="col-lg-5 col-md-6"><label for="driver-search" class="form-label">Recherche</label><input id="driver-search" name="Search" value="@Model.Criteria.Search" class="form-control" placeholder="Nom ou identifiant" /></div>
    <div class="col-lg-3 col-md-6"><label for="driver-status" class="form-label">Statut réel</label><select id="driver-status" name="Status" class="form-select"><option value="">Tous les statuts</option>@foreach (var status in Model.FilterOptions.Statuses) { <option value="@status" selected="@(Model.Criteria.Status == status ? "selected" : null)">@DriverPresentation.GetStatusLabel(status)</option> }</select></div>
    <div class="col-lg-2 col-md-6"><label for="driver-page-size" class="form-label">Par page</label><select id="driver-page-size" name="PageSize" class="form-select">@foreach (var size in DriverSearchCriteria.AllowedPageSizes) { <option value="@size" selected="@(Model.Criteria.PageSize == size ? "selected" : null)">@size</option> }</select></div>
    <div class="col-lg-2 col-md-6 d-flex align-items-end gap-2"><button type="submit" class="btn btn-primary">Rechercher</button><a asp-action="Index" class="btn btn-outline-secondary">Réinitialiser</a></div>
</form></div></section>
<section aria-labelledby="driver-results-title"><div class="d-flex justify-content-between align-items-center gap-2 mb-3"><h2 id="driver-results-title" class="h5 mb-0">Conducteurs enregistrés</h2><p id="driver-summary" class="text-muted mb-0"><strong>@Model.Results.TotalItems.ToString("N0", culture)</strong> conducteur@(Model.Results.TotalItems == 1 ? "" : "s")</p></div>
@if (Model.Results.Items.Count == 0) { <div class="card border-0 shadow-sm"><div class="card-body trip-empty-state text-center"><h3 class="h5">Aucun conducteur</h3><p class="text-muted">Aucun conducteur ne correspond aux critères sélectionnés.</p><a asp-action="Index" class="btn btn-outline-secondary">Réinitialiser les filtres</a></div></div> }
else { <div class="card border-0 shadow-sm trip-results-card"><div class="table-responsive"><table class="table table-hover align-middle mb-0 fleet-table" aria-describedby="driver-summary"><thead><tr><th scope="col">Conducteur</th><th scope="col">Identifiant</th><th scope="col">Statut réel</th><th scope="col" class="text-end">Voyages</th><th scope="col" class="text-end">Arrêts</th><th scope="col">Dernière activité</th><th scope="col"><span class="visually-hidden">Action</span></th></tr></thead><tbody>
@foreach (var driver in Model.Results.Items) { <tr><th scope="row">@driver.DisplayName</th><td>@driver.DriverCode</td><td><span class="badge @DriverPresentation.GetStatusBadgeClass(driver.Status, driver.IsActive)">@DriverPresentation.GetStatusLabel(driver.Status)</span></td><td class="text-end">@driver.TripCount.ToString("N0", culture)</td><td class="text-end">@driver.StopCount.ToString("N0", culture)</td><td>@DriverPresentation.FormatDate(DriverPresentation.LatestActivity(driver.LastTripActivity, driver.LastStopActivity))</td><td class="text-end"><a asp-action="Details" asp-all-route-data="@Model.DetailsRouteValues(driver.DriverId)" class="btn btn-sm btn-outline-primary" aria-label="Voir le conducteur @driver.DriverCode">Voir</a></td></tr> }
</tbody></table></div><div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-3"><span class="text-muted small">Page @Model.Results.Page sur @Model.Results.TotalPages</span><nav aria-label="Pagination des conducteurs"><ul class="pagination pagination-sm mb-0"><li class="page-item @(!Model.Results.HasPreviousPage ? "disabled" : null)">@if (Model.Results.HasPreviousPage) { <a class="page-link" asp-action="Index" asp-all-route-data="@Model.RouteValuesFor(Model.Results.Page - 1)">Précédent</a> } else { <span class="page-link" aria-disabled="true">Précédent</span> }</li>@foreach (var pageNumber in Model.VisiblePages) { <li class="page-item @(pageNumber == Model.Results.Page ? "active" : null)">@if (pageNumber == Model.Results.Page) { <span class="page-link" aria-current="page">@pageNumber</span> } else { <a class="page-link" asp-action="Index" asp-all-route-data="@Model.RouteValuesFor(pageNumber)">@pageNumber</a> }</li> }<li class="page-item @(!Model.Results.HasNextPage ? "disabled" : null)">@if (Model.Results.HasNextPage) { <a class="page-link" asp-action="Index" asp-all-route-data="@Model.RouteValuesFor(Model.Results.Page + 1)">Suivant</a> } else { <span class="page-link" aria-disabled="true">Suivant</span> }</li></ul></nav></div></div> }
</section>
