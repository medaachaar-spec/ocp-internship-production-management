@model OcpProduction.Web.ViewModels.Drivers.DriverDetailsViewModel
@using System.Globalization
@using OcpProduction.Web.ViewModels.Drivers
@{
    ViewData["Title"] = $"Détail du conducteur {Model.Driver.DriverCode}";
    var culture = CultureInfo.GetCultureInfo("fr-FR");
}
<nav aria-label="Fil d’Ariane" class="mb-3"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Accueil</a></li><li class="breadcrumb-item"><a asp-action="Index" asp-all-route-data="@Model.ReturnRouteValues">Conducteurs</a></li><li class="breadcrumb-item active" aria-current="page">@Model.Driver.DriverCode</li></ol></nav>
<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3"><div><h1>Détail du conducteur @Model.Driver.DriverCode</h1><p class="text-muted mb-0">Activité opérationnelle factuelle, sans évaluation RH.</p></div><span class="badge fs-6 @DriverPresentation.GetStatusBadgeClass(Model.Driver.Status, Model.Driver.IsActive)">@DriverPresentation.GetStatusLabel(Model.Driver.Status)</span></div>
<div class="row g-4">
    <div class="col-xl-6"><section class="card border-0 shadow-sm h-100" aria-labelledby="driver-general"><div class="card-body"><h2 id="driver-general" class="h5 mb-3">Informations générales</h2><dl class="trip-details-grid mb-0"><div><dt>Conducteur</dt><dd>@Model.Driver.DisplayName</dd></div><div><dt>Identifiant</dt><dd>@Model.Driver.DriverCode</dd></div><div><dt>Statut réel</dt><dd>@DriverPresentation.GetStatusLabel(Model.Driver.Status)</dd></div><div><dt>Référence active</dt><dd>@DriverPresentation.GetActiveLabel(Model.Driver.IsActive)</dd></div><div><dt>Enregistré le</dt><dd>@DriverPresentation.FormatDate(Model.Driver.CreatedAt)</dd></div></dl></div></section></div>
    <div class="col-xl-6"><section class="card border-0 shadow-sm h-100" aria-labelledby="driver-trips"><div class="card-body"><h2 id="driver-trips" class="h5 mb-3">Activité des voyages</h2><dl class="trip-details-grid mb-3"><div><dt>Voyages</dt><dd>@Model.Driver.TripCount.ToString("N0", culture)</dd></div><div><dt>Terminés</dt><dd>@Model.Driver.CompletedTripCount.ToString("N0", culture)</dd></div><div><dt>Tonnage total</dt><dd>@DriverPresentation.FormatTonnage(Model.Driver.TotalTonnage)</dd></div><div><dt>Durée moyenne</dt><dd>@DriverPresentation.FormatDuration(Model.Driver.AverageTripDurationMinutes)</dd></div><div><dt>Première activité</dt><dd>@DriverPresentation.FormatDate(Model.Driver.FirstTripDate)</dd></div><div><dt>Dernière activité</dt><dd>@DriverPresentation.FormatDate(Model.Driver.LastTripDate)</dd></div></dl>@if (Model.CanViewTrips) { <a asp-controller="Trips" asp-action="Index" asp-route-DriverId="@Model.Driver.DriverId" class="btn btn-sm btn-outline-primary">Voir les voyages</a> }</div></section></div>
    <div class="col-xl-6"><section class="card border-0 shadow-sm h-100" aria-labelledby="driver-stops"><div class="card-body"><h2 id="driver-stops" class="h5 mb-3">Activité des arrêts</h2><dl class="trip-details-grid mb-3"><div><dt>Arrêts associés</dt><dd>@Model.Driver.StopCount.ToString("N0", culture)</dd></div><div><dt>Durée totale liée</dt><dd>@DriverPresentation.FormatDuration(Model.Driver.TotalStopDurationMinutes)</dd></div><div><dt>Durée moyenne liée</dt><dd>@DriverPresentation.FormatDuration(Model.Driver.AverageStopDurationMinutes)</dd></div></dl>@if (Model.CanViewStops) { <a asp-controller="Stops" asp-action="Index" asp-route-DriverId="@Model.Driver.DriverId" class="btn btn-sm btn-outline-primary">Voir les arrêts</a> }</div></section></div>
    <div class="col-xl-6"><section class="card border-0 shadow-sm h-100" aria-labelledby="driver-performance"><div class="card-body"><h2 id="driver-performance" class="h5 mb-3">Indicateurs de performance descriptifs</h2><p class="mb-0">Ces indicateurs décrivent l’activité enregistrée et ne constituent pas une évaluation RH.</p><p class="text-muted small mt-3 mb-0">Aucune donnée de licence, d’adresse, d’identité nationale, médicale, salariale ou disciplinaire n’est affichée.</p></div></section></div>
</div>
<div class="mt-4"><a asp-action="Index" asp-all-route-data="@Model.ReturnRouteValues" class="btn btn-outline-secondary">Retour à la liste</a></div>
