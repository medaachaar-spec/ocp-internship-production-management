@model OcpProduction.Web.ViewModels.Drivers.DriverDetailsViewModel
@using System.Globalization
@using OcpProduction.Web.ViewModels.Drivers
@{
    ViewData["Title"] = $"Détail du conducteur {Model.Driver.DriverCode}";
    var culture = CultureInfo.GetCultureInfo("fr-FR");
}

<div class="detail-page">
    <nav aria-label="Fil d’Ariane" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Accueil</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" asp-all-route-data="@Model.ReturnRouteValues">Conducteurs</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Driver.DriverCode</li>
        </ol>
    </nav>

    <header class="detail-header">
        <div class="detail-header__identity">
            <p class="detail-header__eyebrow">Conducteur</p>
            <h1>@Model.Driver.DriverCode</h1>
            <p>@Model.Driver.DisplayName · Activité opérationnelle factuelle.</p>
        </div>
        <div class="detail-header__actions">
            <span class="badge status-badge @DriverPresentation.GetStatusBadgeClass(Model.Driver.Status, Model.Driver.IsActive)">
                @DriverPresentation.GetStatusLabel(Model.Driver.Status)
            </span>
        </div>
    </header>

    <div class="row g-4">
        <div class="col-xl-5">
            <section class="detail-section-card" aria-labelledby="driver-general">
                <div class="detail-section-card__body">
                    <h2 id="driver-general" class="detail-section-heading">Identité</h2>
                    <dl class="trip-details-grid detail-definition-grid mb-0">
                        <div>
                            <dt>Conducteur</dt>
                            <dd>@Model.Driver.DisplayName</dd>
                        </div>
                        <div>
                            <dt>Identifiant</dt>
                            <dd>@Model.Driver.DriverCode</dd>
                        </div>
                        <div>
                            <dt>Statut enregistré</dt>
                            <dd>@DriverPresentation.GetStatusLabel(Model.Driver.Status)</dd>
                        </div>
                        <div>
                            <dt>Référence active</dt>
                            <dd>@DriverPresentation.GetActiveLabel(Model.Driver.IsActive)</dd>
                        </div>
                        <div>
                            <dt>Enregistré le</dt>
                            <dd>@DriverPresentation.FormatDate(Model.Driver.CreatedAt)</dd>
                        </div>
                    </dl>
                    <p class="detail-note">Les données affichées décrivent l’activité enregistrée et ne constituent pas une évaluation RH.</p>
                </div>
            </section>
        </div>

        <div class="col-xl-7">
            <section class="detail-section-card" aria-labelledby="driver-trips">
                <div class="detail-section-card__body">
                    <h2 id="driver-trips" class="detail-section-heading">Activité des voyages</h2>
                    <dl class="trip-details-grid detail-definition-grid mb-0">
                        <div>
                            <dt>Voyages</dt>
                            <dd>@Model.Driver.TripCount.ToString("N0", culture)</dd>
                        </div>
                        <div>
                            <dt>Terminés</dt>
                            <dd>@Model.Driver.CompletedTripCount.ToString("N0", culture)</dd>
                        </div>
                        <div>
                            <dt>Tonnage total</dt>
                            <dd>@DriverPresentation.FormatTonnage(Model.Driver.TotalTonnage)</dd>
                        </div>
                        <div>
                            <dt>Durée moyenne</dt>
                            <dd>@DriverPresentation.FormatDuration(Model.Driver.AverageTripDurationMinutes)</dd>
                        </div>
                        <div>
                            <dt>Première activité</dt>
                            <dd>@DriverPresentation.FormatDate(Model.Driver.FirstTripDate)</dd>
                        </div>
                        <div>
                            <dt>Dernière activité</dt>
                            <dd>@DriverPresentation.FormatDate(Model.Driver.LastTripDate)</dd>
                        </div>
                    </dl>
                    @if (Model.CanViewTrips)
                    {
                        <div class="detail-section-actions">
                            <a asp-controller="Trips"
                               asp-action="Index"
                               asp-route-DriverId="@Model.Driver.DriverId"
                               class="btn btn-sm btn-outline-primary">Voir les voyages</a>
                        </div>
                    }
                </div>
            </section>
        </div>

        <div class="col-12">
            <section class="detail-section-card" aria-labelledby="driver-stops">
                <div class="detail-section-card__body">
                    <h2 id="driver-stops" class="detail-section-heading">Arrêts associés</h2>
                    <dl class="trip-details-grid detail-definition-grid mb-0">
                        <div>
                            <dt>Arrêts associés</dt>
                            <dd>@Model.Driver.StopCount.ToString("N0", culture)</dd>
                        </div>
                        <div>
                            <dt>Durée totale liée</dt>
                            <dd>@DriverPresentation.FormatDuration(Model.Driver.TotalStopDurationMinutes)</dd>
                        </div>
                        <div>
                            <dt>Durée moyenne liée</dt>
                            <dd>@DriverPresentation.FormatDuration(Model.Driver.AverageStopDurationMinutes)</dd>
                        </div>
                    </dl>
                    @if (Model.CanViewStops)
                    {
                        <div class="detail-section-actions">
                            <a asp-controller="Stops"
                               asp-action="Index"
                               asp-route-DriverId="@Model.Driver.DriverId"
                               class="btn btn-sm btn-outline-primary">Voir les arrêts</a>
                        </div>
                    }
                </div>
            </section>
        </div>
    </div>

    <div class="detail-footer-actions">
        <a asp-action="Index"
           asp-all-route-data="@Model.ReturnRouteValues"
           class="btn btn-outline-secondary">Retour à la liste</a>
    </div>
</div>
