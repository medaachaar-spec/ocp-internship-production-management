@model OcpProduction.Web.ViewModels.Trucks.TruckDetailsViewModel
@using System.Globalization
@using OcpProduction.Web.ViewModels.Trucks
@{
    ViewData["Title"] = $"Détail du camion {Model.Truck.TruckCode}";
    var culture = CultureInfo.GetCultureInfo("fr-FR");
}

<div class="detail-page">
    <nav aria-label="Fil d’Ariane" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Accueil</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" asp-all-route-data="@Model.ReturnRouteValues">Camions</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Truck.TruckCode</li>
        </ol>
    </nav>

    <header class="detail-header">
        <div class="detail-header__identity">
            <p class="detail-header__eyebrow">Camion</p>
            <h1>@Model.Truck.TruckCode</h1>
            <p>Informations enregistrées et activité opérationnelle descriptive.</p>
        </div>
        <div class="detail-header__actions">
            <span class="badge status-badge @TruckPresentation.GetStatusBadgeClass(Model.Truck.Status, Model.Truck.IsActive)">
                @TruckPresentation.GetStatusLabel(Model.Truck.Status)
            </span>
        </div>
    </header>

    <div class="row g-4">
        <div class="col-xl-6">
            <section class="detail-section-card" aria-labelledby="truck-general">
                <div class="detail-section-card__body">
                    <h2 id="truck-general" class="detail-section-heading">Identité</h2>
                    <dl class="trip-details-grid detail-definition-grid mb-0">
                        <div>
                            <dt>Code</dt>
                            <dd>@Model.Truck.TruckCode</dd>
                        </div>
                        <div>
                            <dt>Immatriculation</dt>
                            <dd>@TruckPresentation.OrFallback(Model.Truck.RegistrationNumber)</dd>
                        </div>
                        <div>
                            <dt>Statut enregistré</dt>
                            <dd>@TruckPresentation.GetStatusLabel(Model.Truck.Status)</dd>
                        </div>
                        <div>
                            <dt>Référence active</dt>
                            <dd>@TruckPresentation.GetActiveLabel(Model.Truck.IsActive)</dd>
                        </div>
                        <div>
                            <dt>Enregistré le</dt>
                            <dd>@TruckPresentation.FormatDate(Model.Truck.CreatedAt)</dd>
                        </div>
                    </dl>
                </div>
            </section>
        </div>

        <div class="col-xl-6">
            <section class="detail-section-card" aria-labelledby="truck-tech">
                <div class="detail-section-card__body">
                    <h2 id="truck-tech" class="detail-section-heading">Informations techniques</h2>
                    <dl class="trip-details-grid detail-definition-grid mb-0">
                        <div>
                            <dt>Modèle ou type</dt>
                            <dd>@TruckPresentation.OrFallback(Model.Truck.Model)</dd>
                        </div>
                        <div>
                            <dt>Capacité nominale</dt>
                            <dd>@TruckPresentation.FormatTonnage(Model.Truck.RatedPayloadTonnes)</dd>
                        </div>
                    </dl>
                    <p class="detail-note">Aucune information de maintenance ou de condition mécanique n’est déduite.</p>
                </div>
            </section>
        </div>

        <div class="col-xl-7">
            <section class="detail-section-card" aria-labelledby="truck-trips">
                <div class="detail-section-card__body">
                    <h2 id="truck-trips" class="detail-section-heading">Activité des voyages</h2>
                    <dl class="trip-details-grid detail-definition-grid mb-0">
                        <div>
                            <dt>Voyages</dt>
                            <dd>@Model.Truck.TripCount.ToString("N0", culture)</dd>
                        </div>
                        <div>
                            <dt>Terminés</dt>
                            <dd>@Model.Truck.CompletedTripCount.ToString("N0", culture)</dd>
                        </div>
                        <div>
                            <dt>Tonnage total</dt>
                            <dd>@TruckPresentation.FormatTonnage(Model.Truck.TotalTonnage)</dd>
                        </div>
                        <div>
                            <dt>Durée moyenne</dt>
                            <dd>@TruckPresentation.FormatDuration(Model.Truck.AverageTripDurationMinutes)</dd>
                        </div>
                        <div>
                            <dt>Première activité</dt>
                            <dd>@TruckPresentation.FormatDate(Model.Truck.FirstTripDate)</dd>
                        </div>
                        <div>
                            <dt>Dernière activité</dt>
                            <dd>@TruckPresentation.FormatDate(Model.Truck.LastTripDate)</dd>
                        </div>
                    </dl>
                    @if (Model.CanViewTrips)
                    {
                        <div class="detail-section-actions">
                            <a asp-controller="Trips"
                               asp-action="Index"
                               asp-route-TruckId="@Model.Truck.TruckId"
                               class="btn btn-sm btn-outline-primary">Voir les voyages</a>
                        </div>
                    }
                </div>
            </section>
        </div>

        <div class="col-xl-5">
            <section class="detail-section-card" aria-labelledby="truck-stops">
                <div class="detail-section-card__body">
                    <h2 id="truck-stops" class="detail-section-heading">Activité des arrêts</h2>
                    <dl class="trip-details-grid detail-definition-grid mb-0">
                        <div>
                            <dt>Arrêts</dt>
                            <dd>@Model.Truck.StopCount.ToString("N0", culture)</dd>
                        </div>
                        <div>
                            <dt>Durée totale</dt>
                            <dd>@TruckPresentation.FormatDuration(Model.Truck.TotalDowntimeMinutes)</dd>
                        </div>
                        <div>
                            <dt>Durée moyenne</dt>
                            <dd>@TruckPresentation.FormatDuration(Model.Truck.AverageStopDurationMinutes)</dd>
                        </div>
                    </dl>
                    @if (Model.CanViewStops)
                    {
                        <div class="detail-section-actions">
                            <a asp-controller="Stops"
                               asp-action="Index"
                               asp-route-TruckId="@Model.Truck.TruckId"
                               class="btn btn-sm btn-outline-primary">Voir les arrêts</a>
                        </div>
                    }
                </div>
            </section>
        </div>
    </div>

    <div class="detail-footer-actions">
        <a asp-action="Index"
           asp-all-route-data="@Model.ReturnRouteValues"
           class="btn btn-outline-secondary">Retour à la liste</a>
    </div>
</div>
