@model OcpProduction.Web.ViewModels.Trucks.TruckDetailsViewModel
@using System.Globalization
@using OcpProduction.Web.ViewModels.Trucks
@{
    ViewData["Title"] = $"Détail du camion {Model.Truck.TruckCode}";
    var culture = CultureInfo.GetCultureInfo("fr-FR");
}
<nav aria-label="Fil d’Ariane" class="mb-3"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Accueil</a></li><li class="breadcrumb-item"><a asp-action="Index" asp-all-route-data="@Model.ReturnRouteValues">Camions</a></li><li class="breadcrumb-item active" aria-current="page">@Model.Truck.TruckCode</li></ol></nav>
<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3"><div><h1>Détail du camion @Model.Truck.TruckCode</h1><p class="text-muted mb-0">Informations enregistrées et activité opérationnelle descriptive.</p></div><span class="badge fs-6 @TruckPresentation.GetStatusBadgeClass(Model.Truck.Status, Model.Truck.IsActive)">@TruckPresentation.GetStatusLabel(Model.Truck.Status)</span></div>
<div class="row g-4">
    <div class="col-xl-6"><section class="card border-0 shadow-sm h-100" aria-labelledby="truck-general"><div class="card-body"><h2 id="truck-general" class="h5 mb-3">Informations générales</h2><dl class="trip-details-grid mb-0"><div><dt>Code</dt><dd>@Model.Truck.TruckCode</dd></div><div><dt>Immatriculation</dt><dd>@TruckPresentation.OrFallback(Model.Truck.RegistrationNumber)</dd></div><div><dt>Statut réel</dt><dd>@TruckPresentation.GetStatusLabel(Model.Truck.Status)</dd></div><div><dt>Référence active</dt><dd>@TruckPresentation.GetActiveLabel(Model.Truck.IsActive)</dd></div><div><dt>Enregistré le</dt><dd>@TruckPresentation.FormatDate(Model.Truck.CreatedAt)</dd></div></dl></div></section></div>
    <div class="col-xl-6"><section class="card border-0 shadow-sm h-100" aria-labelledby="truck-tech"><div class="card-body"><h2 id="truck-tech" class="h5 mb-3">Caractéristiques réellement stockées</h2><dl class="trip-details-grid mb-0"><div><dt>Modèle ou type</dt><dd>@TruckPresentation.OrFallback(Model.Truck.Model)</dd></div><div><dt>Capacité nominale</dt><dd>@TruckPresentation.FormatTonnage(Model.Truck.RatedPayloadTonnes)</dd></div></dl><p class="text-muted small mt-3 mb-0">Aucune information de maintenance ou de condition mécanique n’est déduite.</p></div></section></div>
    <div class="col-xl-6"><section class="card border-0 shadow-sm h-100" aria-labelledby="truck-trips"><div class="card-body"><h2 id="truck-trips" class="h5 mb-3">Activité des voyages</h2><dl class="trip-details-grid mb-3"><div><dt>Voyages</dt><dd>@Model.Truck.TripCount.ToString("N0", culture)</dd></div><div><dt>Terminés</dt><dd>@Model.Truck.CompletedTripCount.ToString("N0", culture)</dd></div><div><dt>Tonnage total</dt><dd>@TruckPresentation.FormatTonnage(Model.Truck.TotalTonnage)</dd></div><div><dt>Durée moyenne</dt><dd>@TruckPresentation.FormatDuration(Model.Truck.AverageTripDurationMinutes)</dd></div><div><dt>Première activité</dt><dd>@TruckPresentation.FormatDate(Model.Truck.FirstTripDate)</dd></div><div><dt>Dernière activité</dt><dd>@TruckPresentation.FormatDate(Model.Truck.LastTripDate)</dd></div></dl>@if (Model.CanViewTrips) { <a asp-controller="Trips" asp-action="Index" asp-route-TruckId="@Model.Truck.TruckId" class="btn btn-sm btn-outline-primary">Voir les voyages</a> }</div></section></div>
    <div class="col-xl-6"><section class="card border-0 shadow-sm h-100" aria-labelledby="truck-stops"><div class="card-body"><h2 id="truck-stops" class="h5 mb-3">Activité des arrêts</h2><dl class="trip-details-grid mb-3"><div><dt>Arrêts</dt><dd>@Model.Truck.StopCount.ToString("N0", culture)</dd></div><div><dt>Durée totale</dt><dd>@TruckPresentation.FormatDuration(Model.Truck.TotalDowntimeMinutes)</dd></div><div><dt>Durée moyenne</dt><dd>@TruckPresentation.FormatDuration(Model.Truck.AverageStopDurationMinutes)</dd></div></dl>@if (Model.CanViewStops) { <a asp-controller="Stops" asp-action="Index" asp-route-TruckId="@Model.Truck.TruckId" class="btn btn-sm btn-outline-primary">Voir les arrêts</a> }</div></section></div>
    <div class="col-12"><section class="card border-0 shadow-sm" aria-labelledby="truck-performance"><div class="card-body"><h2 id="truck-performance" class="h5 mb-2">Indicateurs de performance descriptifs</h2><p class="text-muted mb-0">Ces valeurs décrivent uniquement l’activité enregistrée. Elles ne constituent ni un score, ni un jugement sur l’équipement.</p></div></section></div>
</div>
<div class="mt-4"><a asp-action="Index" asp-all-route-data="@Model.ReturnRouteValues" class="btn btn-outline-secondary">Retour à la liste</a></div>
