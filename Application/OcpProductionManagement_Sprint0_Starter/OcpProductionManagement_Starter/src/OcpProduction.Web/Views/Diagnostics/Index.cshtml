@model OcpProduction.Web.ViewModels.Diagnostics.DiagnosticsViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Diagnostic technique";
    var frenchCulture = CultureInfo.GetCultureInfo("fr-FR");
}

<div class="diagnostics-page">
    <header class="diagnostics-header">
        <div>
            <p class="diagnostics-eyebrow">Administration système</p>
            <h1>Diagnostic technique</h1>
            <p class="diagnostics-subtitle">
                État des services nécessaires au fonctionnement de l’application
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-primary">Actualiser le diagnostic</a>
    </header>

    <p class="diagnostics-check-time">
        Dernière vérification :
        <time datetime="@Model.LastCheckedAt.ToString("O", CultureInfo.InvariantCulture)">
            @Model.LastCheckedAt.ToString("dd/MM/yyyy HH:mm:ss", frenchCulture)
        </time>
    </p>

    <section class="diagnostics-grid" aria-label="État des services">
        <article class="diagnostics-card">
            <div class="diagnostics-card-heading">
                <h2>Application</h2>
                <span class="diagnostics-status">
                    @(Model.ApplicationAvailable ? "Disponible" : "Indisponible")
                </span>
            </div>
            <p>L’interface applicative répond à la présente vérification.</p>
        </article>

        <article class="diagnostics-card">
            <div class="diagnostics-card-heading">
                <h2>SQL Server</h2>
                <span class="diagnostics-status">
                    @(Model.DatabaseConnected ? "Accessible" : "Inaccessible")
                </span>
            </div>
            <p>@Model.DatabaseMessage</p>
        </article>

        <article class="diagnostics-card">
            <div class="diagnostics-card-heading">
                <h2>Base de données</h2>
                <span class="diagnostics-status">
                    @(Model.DatabaseConnected ? "Accessible" : "Inaccessible")
                </span>
            </div>
            <p>
                @(Model.DatabaseConnected
                    ? "La base de données répond à une vérification de connexion en lecture seule."
                    : "La disponibilité de la base de données n’a pas pu être confirmée.")
            </p>
        </article>
    </section>

    <section class="diagnostics-context" aria-labelledby="diagnostics-context-heading">
        <h2 id="diagnostics-context-heading">Informations d’exécution</h2>
        <dl>
            <div>
                <dt>Environnement</dt>
                <dd>@Model.EnvironmentName</dd>
            </div>
            <div>
                <dt>Version de l’application</dt>
                <dd>@Model.ApplicationVersion</dd>
            </div>
        </dl>
    </section>

    <p class="diagnostics-note">
        Cette page présente uniquement des états de disponibilité. Elle n’affiche ni identifiants,
        ni chaîne de connexion, ni détails de topologie serveur.
    </p>
</div>
