@model OcpProduction.Web.ViewModels.Diagnostics.DiagnosticsViewModel
@{
    ViewData["Title"] = "Diagnostic technique";
}
<div class="page-header">
    <h1>Diagnostic technique</h1>
    <p class="text-muted">Vérification du Sprint 0 sans modifier la base SQL Server.</p>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0">Connexion SQL Server</h2>
            @if (Model.DatabaseConnected)
            {
                <span class="badge text-bg-success">Connectée</span>
            }
            else
            {
                <span class="badge text-bg-danger">Non connectée</span>
            }
        </div>
        <p>@Model.DatabaseMessage</p>
        <dl class="row mb-0">
            <dt class="col-sm-3">Serveur</dt>
            <dd class="col-sm-9">@(Model.Server ?? "-")</dd>
            <dt class="col-sm-3">Base</dt>
            <dd class="col-sm-9">@(Model.Database ?? "-")</dd>
        </dl>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h2 class="h5">Contexte applicatif</h2>
        <dl class="row mb-0">
            <dt class="col-sm-3">Environnement</dt>
            <dd class="col-sm-9">@Model.EnvironmentName</dd>
            <dt class="col-sm-3">Utilisateur</dt>
            <dd class="col-sm-9">@Model.CurrentUser</dd>
            <dt class="col-sm-3">Rôle</dt>
            <dd class="col-sm-9">@Model.CurrentRole</dd>
        </dl>
    </div>
</div>
