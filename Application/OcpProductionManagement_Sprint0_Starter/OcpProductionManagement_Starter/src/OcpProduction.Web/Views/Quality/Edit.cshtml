@model OcpProduction.Web.ViewModels.Quality.QualityFormViewModel<OcpProduction.Web.ViewModels.Quality.QualityEditInputModel>
@using OcpProduction.Web.ViewModels.Quality
@{
    ViewData["Title"] = Model.PageTitle;
}

<nav aria-label="Fil d’Ariane" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Accueil</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-all-route-data="@Model.ReturnRouteValues">Résultats qualité</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-all-route-data="@Model.DetailsRouteValues(Model.Input.QualityResultId)">Analyse #@Model.Input.QualityResultId</a></li>
        <li class="breadcrumb-item active" aria-current="page">Modifier</li>
    </ol>
</nav>

<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
        <h1>@Model.PageTitle</h1>
        <p class="text-muted mb-0">Corrigez uniquement la mesure et son contexte enregistré.</p>
    </div>
    <span class="badge @QualityPresentation.GetStatusBadgeClass(Model.CurrentStatus)">
        @QualityPresentation.GetStatusLabel(Model.CurrentStatus)
    </span>
</div>

<section class="card border-0 shadow-sm" aria-labelledby="quality-edit-title">
    <div class="card-body p-4">
        <h2 id="quality-edit-title" class="visually-hidden">Formulaire de modification</h2>
        <form asp-action="Edit" asp-route-id="@Model.Input.QualityResultId" method="post" asp-antiforgery="true" novalidate>
            <input asp-for="Input.QualityResultId" type="hidden" />
            <partial name="_QualityForm" model="Model" />
            <div class="mt-4 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">@Model.SubmitLabel</button>
                <a asp-action="Details" asp-all-route-data="@Model.DetailsRouteValues(Model.Input.QualityResultId)" class="btn btn-outline-secondary">Annuler</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
