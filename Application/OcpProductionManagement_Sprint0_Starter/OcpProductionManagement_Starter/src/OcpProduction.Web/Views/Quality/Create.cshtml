@model OcpProduction.Web.ViewModels.Quality.QualityFormViewModel<OcpProduction.Web.ViewModels.Quality.QualityCreateInputModel>
@{
    ViewData["Title"] = Model.PageTitle;
}

<nav aria-label="Fil d’Ariane" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Accueil</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-all-route-data="@Model.ReturnRouteValues">Résultats qualité</a></li>
        <li class="breadcrumb-item active" aria-current="page">Nouvelle analyse</li>
    </ol>
</nav>

<div class="page-header">
    <h1>@Model.PageTitle</h1>
    <p class="text-muted mb-0">Enregistrez une mesure qualité à partir des données vérifiées.</p>
</div>

<section class="card border-0 shadow-sm" aria-labelledby="quality-create-title">
    <div class="card-body p-4">
        <h2 id="quality-create-title" class="visually-hidden">Formulaire de création</h2>
        <form asp-action="Create" method="post" asp-antiforgery="true" novalidate>
            <partial name="_QualityForm" model="Model" />
            <div class="mt-4 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">@Model.SubmitLabel</button>
                <a asp-action="Index" asp-all-route-data="@Model.ReturnRouteValues" class="btn btn-outline-secondary">Annuler</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
